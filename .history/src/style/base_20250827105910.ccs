/* ===== 设计令牌（可按需微调） ===== */
:root{
  --bg:#ffffff;
  --fg:#111111;
  --muted:#666666;
  --grid:rgba(0,0,0,.08);
  --container: 1200px;
  --space: clamp(10px, 1.2vw, 20px);
  --radius: 16px;
  --border: 1px solid rgba(0,0,0,.15);
}

/* ===== 重置 & 基础 ===== */
*{ box-sizing: border-box; }
html{
  font-size: clamp(14px, .9vw + 10px, 18px);
}
body{
  margin:0;
  color:var(--fg);
  background: var(--bg);
  font-family: ui-sans-serif, -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,"Apple Color Emoji","Segoe UI Emoji";
  line-height: 1.6;
  letter-spacing: .01em;
}

/* ===== 页面网格感（细线 + 留白） ===== */
.site{
  min-height:100dvh;
  display:flex; flex-direction:column;
  background:
    repeating-linear-gradient(
      to right,
      transparent 0, transparent 119px, rgba(0,0,0,.06) 120px
    );
  background-size: 120px 100%;
}
.main{
  width: min(100%, var(--container));
  margin: 0 auto;
  padding: calc(var(--space)*2) var(--space) calc(var(--space)*3);
}

/* ===== 通用样式 ===== */
.container{ width:min(100%, var(--container)); margin:0 auto; padding: 0 var(--space); }
.row{ display:grid; grid-template-columns: repeat(12, 1fr); gap: var(--space); }
.border{ border: var(--border); border-radius: var(--radius); }
a{ color:inherit; text-decoration:none; }
a:hover{ text-decoration: underline; text-underline-offset: 3px; }
.small{ font-size:.9em; color:var(--muted); }

/* ===== 头部/底部 ===== */
.header{
  position: sticky; top:0; z-index:10;
  background: var(--bg);
  border-bottom: var(--border);
}
.nav{
  width:min(100%, var(--container));
  margin:0 auto;
  display:flex; align-items:center; justify-content:space-between;
  padding: .9rem var(--space);
}
.brand{ letter-spacing:.08em; text-transform:uppercase; font-weight:600; }
.nav a{ margin-left: 1rem; }

/* ===== 主页区块 ===== */
.hero{
  padding: calc(var(--space)*3) var(--space) calc(var(--space)*2);
  display:grid; grid-template-columns: 1.2fr .8fr; gap: var(--space);
}
.hero h1{
  margin:0 0 .6rem 0;
  font-size: clamp(28px, 3.6vw, 48px);
  font-weight: 500;
  letter-spacing: .02em;
}
.hero p{ color: var(--muted); max-width: 48ch; }

.kicker{
  text-transform: uppercase;
  letter-spacing: .12em;
  font-size: .78rem;
  color: var(--muted);
  margin-bottom: .6rem;
}

/* ===== 项目网格 ===== */
.grid{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space);
}
@media (max-width: 980px){
  .hero{ grid-template-columns: 1fr; }
  .grid{ grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px){
  .grid{ grid-template-columns: 1fr; }
}

/* 卡片 */
.card{
  display:flex; flex-direction:column;
  overflow:hidden; border-radius: var(--radius);
  border: var(--border);
  transition: transform .25s ease, box-shadow .25s ease;
  background: #fff;
}
.card:hover{ transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,.06); }
.thumb{
  aspect-ratio: 4 / 3;
  background: #f5f5f5 url("/bg.gif") center/cover no-repeat; /* 可替换 */
  border-bottom: var(--border);
}
.card-body{ padding: 14px; }
.card-title{ margin: 0 0 4px 0; font-weight: 600; }
.card-meta{ color: var(--muted); font-size: .9em; }

/* 底部 */
.footer{
  margin-top:auto;
  border-top: var(--border);
  background: var(--bg);
}
.footer-inner{
  width:min(100%, var(--container));
  margin:0 auto; padding: 16px var(--space);
  display:flex; justify-content:space-between; flex-wrap:wrap;
  gap: 8px;
}